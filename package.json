{
  "name": "motherland-crm-solution",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next && rm -rf node_modules && npm install",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "test:import-load": "RUN_IMPORT_MONGO_LOAD=1 node --env-file=.env scripts/import-load-harness.mjs",
    "test:import-load:correctness": "RUN_IMPORT_MONGO_LOAD=1 IMPORT_LOAD_PROFILE=correctness node --env-file=.env scripts/import-load-harness.mjs",
    "test:import-load:medium": "RUN_IMPORT_MONGO_LOAD=1 IMPORT_LOAD_PROFILE=medium node --env-file=.env scripts/import-load-harness.mjs",
    "test:import-load:concurrent10k": "RUN_IMPORT_MONGO_LOAD=1 IMPORT_LOAD_PROFILE=concurrent10k node --env-file=.env scripts/import-load-harness.mjs",
    "test:import-load:heavy": "RUN_IMPORT_MONGO_LOAD=1 IMPORT_LOAD_PROFILE=heavy node --env-file=.env scripts/import-load-harness.mjs",
    "test:import-load:stress": "RUN_IMPORT_MONGO_LOAD=1 IMPORT_LOAD_PROFILE=stress node --env-file=.env scripts/import-load-harness.mjs",
    "test:import-load:vitest": "RUN_IMPORT_MONGO_LOAD=1 vitest run src/tests/import.mongo.load.test.ts",
    "test:import-load:standard": "RUN_IMPORT_MONGO_LOAD=1 IMPORT_LOAD_PROFILE=medium node --env-file=.env scripts/import-load-harness.mjs",
    "test:import-midflight-kill": "RUN_IMPORT_MONGO_LOAD=1 node --env-file=.env scripts/import-midflight-kill.mjs",
    "test:import-http-soak": "IMPORT_HTTP_SOAK=1 playwright test e2e/import-http-soak.spec.ts",
    "test:import-http-soak:50k": "IMPORT_HTTP_SOAK=1 IMPORT_SOAK_SIZE=50000 playwright test e2e/import-http-soak.spec.ts",
    "test:import-http-bench:50k": "IMPORT_PERF_STATS=1 IMPORT_SOAK_SIZE=50000 node --env-file=.env scripts/import-http-bench-compare.mjs",
    "test:e2e:seed-concurrent": "node --env-file=.env scripts/e2e-seed-concurrent-tenants.mjs",
    "test:import-http-concurrent": "IMPORT_HTTP_CONCURRENT=1 IMPORT_WORKER_MAX_JOBS=5 playwright test e2e/import-http-concurrent.spec.ts",
    "test:import-http-concurrent:50k": "IMPORT_HTTP_CONCURRENT=1 IMPORT_CONCURRENT_TENANTS=5 IMPORT_CONCURRENT_SIZE=50000 IMPORT_WORKER_MAX_JOBS=5 playwright test e2e/import-http-concurrent.spec.ts",
    "test:import-http-same-tenant": "IMPORT_HTTP_SAME_TENANT=1 IMPORT_STAGE_AUTO_KICK=0 playwright test e2e/import-http-same-tenant.spec.ts",
    "test:import-browser-pressure": "IMPORT_BROWSER_PRESSURE=1 playwright test e2e/import-browser-pressure.spec.ts",
    "test:import-browser-pressure:50k": "IMPORT_BROWSER_PRESSURE=1 IMPORT_BROWSER_ROWS=50000 playwright test e2e/import-browser-pressure.spec.ts",
    "test:assign-bulk-bench": "ASSIGN_BULK_BENCH=1 ASSIGN_BENCH_SIZE=500 playwright test e2e/assignment-bulk-bench.spec.ts",
    "test:assign-bulk-bench:200": "ASSIGN_BULK_BENCH=1 ASSIGN_BENCH_SIZE=200 playwright test e2e/assignment-bulk-bench.spec.ts",
    "test:assign-bulk-bench:500": "ASSIGN_BULK_BENCH=1 ASSIGN_BENCH_SIZE=500 playwright test e2e/assignment-bulk-bench.spec.ts",
    "test:leads-filters-bench": "LEADS_FILTER_BENCH=1 LEADS_FILTER_BENCH_SIZE=100 playwright test e2e/leads-filters-bench.spec.ts",
    "test:leads-filters-bench:200": "LEADS_FILTER_BENCH=1 LEADS_FILTER_BENCH_SIZE=200 playwright test e2e/leads-filters-bench.spec.ts",
    "test:leads-startup-bench:dev": "LEADS_BENCH_STARTUP=1 LEADS_FILTER_BENCH=1 API_PERF_TIMING=1 playwright test e2e/leads-startup-bench.spec.ts",
    "test:leads-startup-bench:dev:fresh": "LEADS_BENCH_STARTUP=1 LEADS_FILTER_BENCH=1 API_PERF_TIMING=1 PLAYWRIGHT_FRESH_SERVER=1 PLAYWRIGHT_PORT=3001 playwright test e2e/leads-startup-bench.spec.ts",
    "test:leads-startup-bench:prod": "node scripts/leads-startup-bench.mjs --prod-only",
    "test:leads-startup-bench": "node scripts/leads-startup-bench.mjs",
    "test:leads-filters-client": "vitest run src/tests/agentLeadsFilter.perf.test.ts",
    "test:leads-assignment-cap": "LEADS_ASSIGNMENT_CAP=1 playwright test e2e/leads-assignment-cap.spec.ts",
    "test:users-create-ui": "USERS_CREATE_UI=1 API_PERF_TIMING=1 playwright test e2e/users-create-ui.spec.ts",
    "test:lead-detail-panel-bench": "LEAD_DETAIL_PANEL_BENCH=1 API_PERF_TIMING=1 playwright test e2e/lead-detail-panel-bench.spec.ts",
    "test:lead-detail-panel-bench:200": "LEAD_DETAIL_PANEL_BENCH=1 LEAD_DETAIL_BENCH_COMMENTS=100 LEAD_DETAIL_BENCH_ACTIVITIES=100 LEAD_DETAIL_BENCH_REMINDERS=10 API_PERF_TIMING=1 playwright test e2e/lead-detail-panel-bench.spec.ts",
    "test:lead-detail-panel-bench:custom": "LEAD_DETAIL_PANEL_BENCH=1 API_PERF_TIMING=1 playwright test e2e/lead-detail-panel-bench.spec.ts",
    "test:lead-detail-panel-bench:prod": "node scripts/wait-for-http.mjs && LEAD_DETAIL_PANEL_BENCH=1 API_PERF_TIMING=1 PLAYWRIGHT_NO_WEBSERVER=1 playwright test e2e/lead-detail-panel-bench.spec.ts",
    "test:lead-detail-panel-edge": "LEAD_DETAIL_PANEL_EDGE=1 playwright test e2e/lead-detail-panel-edge.spec.ts",
    "test:all-leads-loading": "ALL_LEADS_LOADING_E2E=1 playwright test e2e/all-leads-loading.spec.ts",
    "mongo:users-create-explain": "node --env-file=.env scripts/mongo-users-create-explain.mjs",
    "mongo:users-create-explain:idle": "node --env-file=.env scripts/mongo-users-create-explain.mjs --idle-test",
    "test:assign-bulk-ui": "ASSIGN_BULK_UI=1 playwright test e2e/assignment-bulk-ui.spec.ts",
    "test:assign-bulk-ui:25": "ASSIGN_BULK_UI=1 ASSIGN_UI_SIZE=25 playwright test e2e/assignment-bulk-ui.spec.ts",
    "test:assign-bulk-ui:fresh": "PLAYWRIGHT_FRESH_SERVER=1 PLAYWRIGHT_PORT=3001 ASSIGN_BULK_UI=1 playwright test e2e/assignment-bulk-ui.spec.ts",
    "test:bulk-realtime-sync": "BULK_REALTIME_SYNC=1 playwright test e2e/bulk-realtime-sync.spec.ts",
    "test:bulk-realtime-sync:fresh": "PLAYWRIGHT_FRESH_SERVER=1 PLAYWRIGHT_PORT=3001 BULK_REALTIME_SYNC=1 playwright test e2e/bulk-realtime-sync.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:seed": "node --env-file=.env scripts/e2e-seed.mjs",
    "test:e2e:cleanup": "node --env-file=.env scripts/e2e-cleanup-disposable.mjs",
    "test:e2e:clean": "rm -rf test-results playwright-report blob-report playwright/.cache e2e/.auth-*.json e2e/.lead-detail-bench.json",
    "cleanup:test-data": "node --env-file=.env scripts/e2e-cleanup-disposable.mjs",
    "generate:fonts": "node scripts/generate-brand-font-loaders.mjs"
  },
